# ─────────────────────────────────────────────────────────────────────────────
# Medaea EHR — Environment Variables Reference
# Copy to .env and fill in real values before running:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Credentials used by the Postgres container and all backend services.
POSTGRES_USER=medaea
POSTGRES_PASSWORD=medaea_secret
POSTGRES_DB=medaea_db
DB_PORT=5432

# ── FastAPI / Core API ────────────────────────────────────────────────────────
FASTAPI_PORT=8000

# REQUIRED IN PRODUCTION
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=supersecretkey_change_in_production
ALGORITHM=HS256

# Token lifetime in minutes (default 8 days)
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# development | staging | production
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed CORS origins (no trailing slash)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173

# Public URL of the frontend — used in email/reset links
FRONTEND_URL=http://localhost:3000

# ── MFA (TOTP) ────────────────────────────────────────────────────────────────
# Fernet symmetric key used to encrypt TOTP secrets stored in the DB.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=b7-PqUqy4_k2zPUHRpsL2PUWmXglTjdBpOZibh6CT7Q=
MFA_TOKEN_EXPIRE_MINUTES=5

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Set REQUIRE_EMAIL_VERIFICATION=true to gate logins on email confirmation.
REQUIRE_EMAIL_VERIFICATION=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL_TLS=false
EMAILS_FROM_EMAIL=noreply@medaea.com
EMAILS_FROM_NAME=Medaea EHR

# ── Twilio (SMS MFA / notifications) ─────────────────────────────────────────
# Leave empty to disable SMS features gracefully.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Django Admin ─────────────────────────────────────────────────────────────
DJANGO_PORT=9000

# REQUIRED IN PRODUCTION
# Generate: python3 -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=django-insecure-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Frontend (React + Vite) ───────────────────────────────────────────────────
FRONTEND_PORT=3000

# Baked into the compiled JS bundle at build time.
# Local Docker Compose: http://localhost:8000
# Production: https://api.yourdomain.com
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Medaea EHR
