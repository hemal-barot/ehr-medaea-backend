FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-django.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONPATH=/app
ENV DJANGO_SETTINGS_MODULE=django_app.config.settings

CMD ["sh", "-c", \
    "python django_app/manage.py migrate --no-input && \
     python django_app/manage.py collectstatic --noinput && \
     gunicorn django_app.config.wsgi:application --bind 0.0.0.0:9000 --workers 2 --timeout 120"]
